DATABASE_URL="postgresql://extremepanic:extremepanic@localhost:5433/extremepanic"
ADMIN_PASSWORD="changeme"

# Square Checkout API (sandbox app credentials from
# https://developer.squareup.com/apps -- do not use production credentials
# in local dev)
SQUARE_ACCESS_TOKEN=""
SQUARE_LOCATION_ID=""
SQUARE_ENVIRONMENT="sandbox"

# Absolute base URL, used to build the redirect Square sends buyers back to
SITE_URL="http://localhost:3000"

# S3 for review image uploads (own bucket + IAM user, separate from
# Breakroom/Prosaurus's bucket -- see CLAUDE.md). Uploading a file errors
# without these; the manual "Image URL" field in the admin form still works
# without them.
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
S3_BUCKET_NAME="extremepanic-uploads"
S3_BUCKET_REGION="us-west-2"
